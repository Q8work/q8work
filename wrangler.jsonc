{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "q8work",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2025-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "q8work-db",
      "database_id": "14ad1f48-b7b1-44a0-b5b8-2dfafb22ad8e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "q8work-uploads"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development"
  }
}
